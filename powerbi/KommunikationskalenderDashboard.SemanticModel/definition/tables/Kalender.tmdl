	partition Kalender = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2027, 12, 31 ) ), "Jahr", YEAR ( [Date] ), "MonatNr", MONTH ( [Date] ), "Monat", FORMAT ( [Date], "MMM", "de-DE" ), "MonatLang", FORMAT ( [Date], "MMMM", "de-DE" ), "JahrMonat", FORMAT ( [Date], "YYYY-MM" ), "JahrMonatSort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ), "Quartal", "Q" & FORMAT ( [Date], "Q" ), "JahrQuartal", FORMAT ( [Date], "YYYY" ) & " Q" & FORMAT ( [Date], "Q" ), "KW", WEEKNUM ( [Date], 2 ), "Wochentag", FORMAT ( [Date], "ddd", "de-DE" ), "WochentagNr", WEEKDAY ( [Date], 2 ), "TagImMonat", DAY ( [Date] ), "IstHeute", IF ( [Date] = TODAY (), "Heute", "" ), "IstVergangenheit", IF ( [Date] < TODAY (), TRUE (), FALSE () ) )

