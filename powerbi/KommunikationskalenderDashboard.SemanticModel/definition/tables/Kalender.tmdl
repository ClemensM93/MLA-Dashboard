table Kalender
	dataCategory: Time

	column Datum
		dataType: dateTime
		isUnique
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]

	column Jahr
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Jahr]

	column MonatNr
