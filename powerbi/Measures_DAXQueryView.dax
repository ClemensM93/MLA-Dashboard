// ============================================================================
// ALLE MEASURES AUF EINMAL EINFUEGEN  (DAX-Abfrageansicht)
// ----------------------------------------------------------------------------
// So sparst du dir das Anlegen jedes einzelnen Measures:
//
//   1. Zuerst die Kalender-Tabelle anlegen (Datei: Kalendertabelle.dax) und
//      die Beziehung ziehen:
//        'Kalender'[Datum]  1:n  'Kommunikationskalender alt'[Event Date]
//
//   2. In Power BI Desktop links das Symbol "DAX-Abfrageansicht" oeffnen
//      (das Symbol mit der Lupe/Tabelle unter Bericht/Daten/Modell).
//
//   3. Diesen GESAMTEN Text hier einfuegen.
//
//   4. Ueber dem Wort "DEFINE" erscheint ein grauer Link (CodeLens):
//        >> "Modell aktualisieren: X neue Measures hinzufuegen" <<
//      Diesen EINMAL anklicken -> alle Measures landen in der Tabelle
//      'Kommunikationskalender alt'.
//
//   5. Fertig. (Die Measures kannst du danach per Drag&Drop im Bericht nutzen.)
//
// Hinweis: Alle Measures liegen als "Home-Tabelle" auf 'Kommunikationskalender alt'.
//          Wenn du sie lieber in einer eigenen Tabelle '_Measures' haettest,
//          ersetze in allen Zeilen 'Kommunikationskalender alt'[<Name>] durch
//          '_Measures'[<Name>] (Tabelle '_Measures' vorher via "Daten eingeben"
//          anlegen).
// ============================================================================

DEFINE
    // --- 1) GRUNDZAHLEN ---------------------------------------------------
    MEASURE 'Kommunikationskalender alt'[Anzahl Kommunikationen] =
        COUNTROWS ( 'Kommunikationskalender alt' )

    MEASURE 'Kommunikationskalender alt'[Anzahl Formate] =
        DISTINCTCOUNT ( 'Kommunikationskalender alt'[Format] )

    // --- 2) ZEITBEZOGEN (nutzt die Kalender-Tabelle) ----------------------
    MEASURE 'Kommunikationskalender alt'[Kommunikationen YTD] =
        TOTALYTD ( [Anzahl Kommunikationen], 'Kalender'[Datum] )

    MEASURE 'Kommunikationskalender alt'[Kommunikationen diesen Monat] =
        CALCULATE (
            [Anzahl Kommunikationen],
            FILTER (
                ALL ( 'Kalender' ),
                'Kalender'[Jahr] = YEAR ( TODAY () )
                    && 'Kalender'[MonatNr] = MONTH ( TODAY () )
            )
        )

    MEASURE 'Kommunikationskalender alt'[Kommunikationen Vormonat] =
        CALCULATE (
            [Anzahl Kommunikationen],
            FILTER (
                ALL ( 'Kalender' ),
                'Kalender'[Jahr] = YEAR ( EDATE ( TODAY (), -1 ) )
                    && 'Kalender'[MonatNr] = MONTH ( EDATE ( TODAY (), -1 ) )
            )
        )

    MEASURE 'Kommunikationskalender alt'[Veraenderung ggue Vormonat] =
        [Kommunikationen diesen Monat] - [Kommunikationen Vormonat]

    MEASURE 'Kommunikationskalender alt'[Veraenderung ggue Vormonat %] =
        VAR Aktuell = [Kommunikationen diesen Monat]
        VAR Vorher  = [Kommunikationen Vormonat]
        RETURN
            IF ( Vorher = 0, BLANK (), DIVIDE ( Aktuell - Vorher, Vorher ) )

    MEASURE 'Kommunikationskalender alt'[Kommunikationen naechste 30 Tage] =
        CALCULATE (
            [Anzahl Kommunikationen],
            FILTER (
                ALL ( 'Kalender' ),
                'Kalender'[Datum] >= TODAY ()
                    && 'Kalender'[Datum] <= TODAY () + 30
            )
        )

    MEASURE 'Kommunikationskalender alt'[Kommunikationen kommende (ab heute)] =
        CALCULATE (
            [Anzahl Kommunikationen],
            FILTER ( ALL ( 'Kalender' ), 'Kalender'[Datum] >= TODAY () )
        )

    MEASURE 'Kommunikationskalender alt'[Kommunikationen vergangen] =
        CALCULATE (
            [Anzahl Kommunikationen],
            FILTER ( ALL ( 'Kalender' ), 'Kalender'[Datum] < TODAY () )
        )

    // --- 3) FORMAT-AUSWERTUNGEN -------------------------------------------
    MEASURE 'Kommunikationskalender alt'[Haeufigstes Format] =
        VAR t =
            ADDCOLUMNS (
                VALUES ( 'Kommunikationskalender alt'[Format] ),
                "@Anzahl", [Anzahl Kommunikationen]
            )
        RETURN
            MAXX ( TOPN ( 1, t, [@Anzahl], DESC ), 'Kommunikationskalender alt'[Format] )

    MEASURE 'Kommunikationskalender alt'[Anteil je Format %] =
        DIVIDE (
            [Anzahl Kommunikationen],
            CALCULATE ( [Anzahl Kommunikationen], ALL ( 'Kommunikationskalender alt'[Format] ) )
        )

    // --- 4) TEXTE FUER KARTEN & DYNAMISCHE TITEL --------------------------
    MEASURE 'Kommunikationskalender alt'[Naechste Kommunikation] =
        VAR NaechstesDatum =
            CALCULATE (
                MIN ( 'Kommunikationskalender alt'[Event Date] ),
                FILTER (
                    'Kommunikationskalender alt',
                    'Kommunikationskalender alt'[Event Date] >= TODAY ()
                )
            )
        VAR Titel =
            CALCULATE (
                SELECTEDVALUE ( 'Kommunikationskalender alt'[Title] ),
                'Kommunikationskalender alt'[Event Date] = NaechstesDatum
            )
        RETURN
            IF (
                ISBLANK ( NaechstesDatum ),
                "Keine geplante Kommunikation",
                FORMAT ( NaechstesDatum, "DD.MM.YYYY" ) & "  –  " & Titel
            )

    MEASURE 'Kommunikationskalender alt'[Titel dynamisch] =
        "Kommunikationskalender  |  Stand: " & FORMAT ( TODAY (), "DD.MM.YYYY" )

    // --- 5) AMPEL-FARBE NACH FORMAT (fuer bedingte Formatierung) ----------
    //     Bezeichnungen an deine echten Format-Werte anpassen!
    MEASURE 'Kommunikationskalender alt'[Farbe Format] =
        SWITCH (
            SELECTEDVALUE ( 'Kommunikationskalender alt'[Format] ),
            "Newsletter",   "#0072CE",
            "Event",        "#2E7D32",
            "Social Media", "#F9A825",
            "Mailing",      "#6A1B9A",
            "#9E9E9E"
        )

// Dummy-Ergebnis, damit die Abfrage lauffaehig ist (wird nicht gebraucht):
EVALUATE
    { 1 }
